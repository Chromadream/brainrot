{
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "refresh": "deno run --allow-net --allow-env=YOUTUBE_API_KEY --allow-read --allow-write _scripts/fetch-playlist.ts"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  },
  "imports": {
    "lume/": "https://deno.land/x/lume@v2.5.3/"
  }
}
